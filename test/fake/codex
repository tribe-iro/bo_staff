#!/usr/bin/env node
// Fake `codex` for tests. `codex --version` prints a version; `codex app-server` plays $FAKE_SCRIPT:
// a JSON array of steps, executed in order:
//   { "on": "<method>", "result": {...}, "then": [...], "delay": ms }  wait for a client request with that method,
//                                                   reply with result (after `delay` ms); notifications in "then" go out
//                                                   in the same write (chunk)
//   { "send": { "method": "...", "params": {...} } }  write a notification
//   { "ask": { "method": "...", "params": {...} } }   send a server request, wait for the client's reply
// Every client message is appended to $FAKE_LOG (JSONL), preceded by one `{ "env": {...}, "argv": [...] }` line with
// the environment variables tests assert on and the arguments before `app-server`. "{{thread}}"/"{{turn}}" are not expanded; scripts use literals.
import { appendFileSync, readFileSync } from "node:fs";
import { createInterface } from "node:readline";

const argv = process.argv.slice(2);
if (argv[0] === "--version") {
  process.stdout.write("codex-cli 0.155.1\n");
  process.exit(0);
}
const steps = JSON.parse(readFileSync(process.env.FAKE_SCRIPT, "utf8"));
if (process.env.FAKE_LOG) {
  const env = Object.fromEntries(["BO_TOKEN", "BO_ALLOW_SUBSCRIPTION_AUTH", "CODEX_HOME", "TMPDIR", "PATH", "SPEC_VAR"].map((k) => [k, process.env[k] ?? null]));
  appendFileSync(process.env.FAKE_LOG, `${JSON.stringify({ env, argv: argv.slice(0, argv.indexOf("app-server")) })}\n`);
}
const inbox = [];
let waiter;
createInterface({ input: process.stdin }).on("line", (line) => {
  if (!line.trim()) return;
  const msg = JSON.parse(line);
  if (process.env.FAKE_LOG) appendFileSync(process.env.FAKE_LOG, `${line}\n`);
  inbox.push(msg);
  waiter?.();
}).on("close", () => process.exit(0));

const next = async (pred) => {
  for (;;) {
    const i = inbox.findIndex(pred);
    if (i >= 0) return inbox.splice(i, 1)[0];
    await new Promise((r) => { waiter = r; });
  }
};
const write = (m) => process.stdout.write(`${JSON.stringify(m)}\n`);
let askId = 1000;
for (const step of steps) {
  if (step.on) {
    const m = await next((x) => x.method === step.on && x.id !== undefined);
    if (step.delay) await new Promise((r) => setTimeout(r, step.delay));
    process.stdout.write([{ id: m.id, result: step.result ?? {} }, ...(step.then ?? [])].map((x) => `${JSON.stringify(x)}\n`).join(""));
  } else if (step.send) {
    write(step.send);
  } else if (step.ask) {
    const id = askId++;
    write({ id, ...step.ask });
    await next((x) => x.id === id && x.method === undefined);
  }
}
await next(() => false);
